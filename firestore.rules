rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/medicalProfile/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId}/nominees/{nomineeEmail} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == nomineeEmail);
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      // Nominees can only set their own UID and nothing else
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        (request.auth.token.email == nomineeEmail && 
         request.auth.token.email_verified == true &&
         resource.data.uid == null && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']) &&
         request.resource.data.uid == request.auth.uid)
      );
    }
    
    match /users/{userId}/publicMeta/{document=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        (
          get(/databases/$(database)/documents/users/$(userId)/nominees/$(request.auth.token.email)).data.uid == request.auth.uid && 
          request.auth.token.email_verified == true
        )
      );
      allow write: if request.auth != null && request.auth.uid == userId
          // Enforce step 1: emergencyResetAt must be server time if changed
          && (
               request.resource.data.get('emergencyResetAt', null) == null ||
               (resource == null && request.resource.data.emergencyResetAt == request.time) ||
               (resource != null && request.resource.data.get('emergencyResetAt', null) == resource.data.get('emergencyResetAt', null)) ||
               (resource != null && request.resource.data.emergencyResetAt == request.time)
             )
          // Enforce step 2: emergencyDeadline must equal reset + duration
          && (
               request.resource.data.get('emergencyDeadline', null) == null ||
               request.resource.data.emergencyDeadline == request.resource.data.emergencyResetAt + duration.value(request.resource.data.get('emergencyDurationHours', 168), 'h')
             )
          // Validate emergencyDurationHours
          && (
               !('emergencyDurationHours' in request.resource.data) ||
               (request.resource.data.emergencyDurationHours > 0 && request.resource.data.emergencyDurationHours <= 87600)
             );
    }
    
    match /users/{userId}/files/{fileId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || 
                  (
                    request.auth != null &&
                    request.auth.token.email_verified == true &&
                    resource.data.isInheritable == true && 
                    get(/databases/$(database)/documents/users/$(userId)/publicMeta/info).data.get('emergencyEnabled', false) == true &&
                    get(/databases/$(database)/documents/users/$(userId)/publicMeta/info).data.get('emergencyDeadline', null) != null &&
                    request.time >= get(/databases/$(database)/documents/users/$(userId)/publicMeta/info).data.emergencyDeadline &&
                    get(/databases/$(database)/documents/users/$(userId)/nominees/$(request.auth.token.email)).data.uid == request.auth.uid
                  );
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/activity_logs/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/notes/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/digital_will/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/expiry_docs/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/nominee_otps/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/notifications/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/pendingOTPs/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/passwords/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/trash/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /files/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /nominees/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /login_attempts/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /share_links/{linkId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}